<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=0：每次 -u 都重套（上游 seed 也是 noupdate=0，會先洗回預設，本模組後載入 ⇒ 我們的值贏） -->
    <data noupdate="0">
        <!-- 隱藏 Home Connect（Smart Home）與 Security Access：停用唯一的兩筆範本，前台建不出來 -->
        <record id="woow_paas_platform.smart_home_home_assistant" model="woow_paas_platform.smart_home_template">
            <field name="is_active" eval="False"/>
        </record>
        <record id="woow_paas_platform.security_access_default" model="woow_paas_platform.security_access_template">
            <field name="is_active" eval="False"/>
        </record>

        <!-- 本機叢集只有 local-path -->
        <record id="lab_storage_class" model="ir.config_parameter">
            <field name="key">woow_paas_platform.storage_class_name</field>
            <field name="value">local-path</field>
        </record>

        <!-- 6 個範本的 chart／image 座標改指 ghcr.io；其餘範本 is_hidden -->
        <function model="woow_paas_platform.cloud_app_template" name="_lab_apply_registry_overrides"/>

        <!-- 方案規格壓到 4GB 節點排得上（上游方案是 noupdate=1，只能用 Python 寫） -->
        <function model="woow_paas_platform.cloud_app_template" name="_lab_setup_plans"/>

        <!-- lab 叢集參數（apiserver 真實位址等） -->
        <function model="woow_paas_platform.cloud_app_template" name="_lab_setup_cluster_params"/>

        <!-- 訂閱計費日記帳（fresh install 沒人設 → 開通服務會被拒） -->
        <function model="woow_paas_platform.cloud_app_template" name="_lab_setup_billing"/>

        <!-- 內部使用：關閉扣款（方案 0 元、不試用、停用扣款相關排程；使用者 2026-11-16） -->
        <function model="woow_paas_platform.cloud_app_template" name="_lab_disable_charging"/>
    </data>
</odoo>
