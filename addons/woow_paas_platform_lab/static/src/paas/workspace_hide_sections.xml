<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- 隱藏 Smart Home（Home Connect）的所有入口（使用者 2026-11-15：先不處理、隱藏）。
         Security Access 2026-11-17 起打開（Cloudflare Tunnel WebGUI 的開通走它），只藏 Smart Home。
         2026-11-15 瀏覽器實測：只拿掉 section 不夠，「探索更多服務」還有卡片（serviceTypes 迴圈）。 -->
    <t t-name="woow_paas_platform.WorkspaceDetailPage" t-inherit="woow_paas_platform.WorkspaceDetailPage" t-inherit-mode="extension">
        <!-- 兩個 section 共用同一個 class；Smart Home 那個是迴圈 state.smartHomes 的 -->
        <xpath expr="//section[@class='o_woow_smart_homes_section'][.//t[@t-foreach='state.smartHomes']]" position="replace"/>
        <!-- 「探索更多服務」三張卡片留雲端服務與安全存取（action: marketplace／security-access／smarthome） -->
        <xpath expr="//t[@t-foreach='serviceTypes']/div" position="attributes">
            <attribute name="t-if">service.action !== 'smarthome'</attribute>
        </xpath>
    </t>
    <!-- 工作區列表頁（還沒有工作區時）的三張介紹卡片：沒有 action 欄位，用 icon 分（cloud／security／home_iot_device） -->
    <t t-name="woow_paas_platform.WorkspaceListPage" t-inherit="woow_paas_platform.WorkspaceListPage" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='serviceTypes']/div" position="attributes">
            <attribute name="t-if">service.icon !== 'home_iot_device'</attribute>
        </xpath>
    </t>
</templates>
